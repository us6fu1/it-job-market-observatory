# Укажите понятный контакт: HH просит идентифицировать приложение.
HH_USER_AGENT=IT-Job-Market-Observatory/0.2 (contact: your-email@example.com)
# Необязателен для sample-режима. Для повторяющегося живого поиска нужен токен приложения.
HH_ACCESS_TOKEN=
HH_BASE_URL=https://api.hh.ru
HH_TIMEOUT_SECONDS=30
HH_MAX_RETRIES=5
HH_RETRY_BASE_SECONDS=1

# Открытый API «Работа России». Токен не требуется.
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1
TRUDVSEM_TIMEOUT_SECONDS=30
TRUDVSEM_MAX_RETRIES=4
TRUDVSEM_RETRY_BASE_SECONDS=1
TRUDVSEM_USER_AGENT=IT-Job-Market-Observatory/0.2

POSTGRES_DB=job_market
POSTGRES_USER=job_market
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://job_market:change_me@localhost:5432/job_market
